# Copy to .env and adjust. .env is gitignored.
# Nothing secret belongs in here — only the *path* to the key.

# BigQuery project dbt writes to.
GCP_PROJECT=your-gcp-project

# Dataset dbt materializes into. Layers append a suffix (_staging, _marts).
DBT_BIGQUERY_DATASET=dbt_dev

# Must match the dataset's region, or BigQuery rejects the job.
DBT_BIGQUERY_LOCATION=US

# Host directory holding sa-key.json, mounted read-only at /var/secrets/google.
# Kept outside the repo on purpose so the key cannot be committed.
SA_KEY_DIR=~/.config/dagster-dbt-bq

# Host port for the Dagster UI.
DAGSTER_PORT=3000

# Container user, so the mounted key (mode 0600) is readable. Set to your own
# `id -u` / `id -g` if they are not 1000.
APP_UID=1000
APP_GID=1000
